{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, hex_id, name, description, created_at, updated_at, deleted_at\n                FROM game\n                WHERE deleted_at IS NULL\n                AND (created_at, hex_id) < ($1, $2)\n                ORDER BY created_at DESC, hex_id DESC\n                LIMIT $3\n                ",
